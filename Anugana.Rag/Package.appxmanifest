<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap rescap mp">

  <Identity
    Name="34488AvnishKumar.AnuganaAI-RagAssistant"
    Publisher="CN=1494B4FB-4349-4083-8AFA-16D2A64B8D99"
    Version="1.1.0.0" />

  <Properties>
    <DisplayName>Anugana AI - Rag Assistant</DisplayName>
    <PublisherDisplayName>Avnish Kumar</PublisherDisplayName>
    <Logo>PackageLogo.png</Logo>
    <Description>Cross-Platform RAG AI Assistant powered by Uno Platform, .NET 10, Qdrant Vector Database, and OpenRouter AI.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Anugana AI - Rag Assistant"
        Description="Cross-Platform RAG AI Assistant powered by Qdrant and OpenRouter AI."
        BackgroundColor="transparent"
        Square150x150Logo="MediumTile.png"
        Square44x44Logo="AppIcon.png">
        <uap:DefaultTile Wide310x150Logo="WideTile.png"  Square71x71Logo="SmallTile.png" Square310x310Logo="LargeTile.png"/>
        <uap:SplashScreen Image="SplashScreen.png" BackgroundColor="#1A0A2E" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

  <mp:PhoneIdentity PhoneProductId="51243b11-1fd0-4884-a140-a4aa2ca35130" PhonePublisherId="1494B4FB-4349-4083-8AFA-16D2A64B8D99"/>
</Package>
